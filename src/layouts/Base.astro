---
import '../styles/global.css';
import LeftRail from '../components/LeftRail.astro';
import TelemetryStrip from '../components/TelemetryStrip.astro';
import HumanViewToggle from '../components/HumanViewToggle.astro';
import HumanPlainView from '../components/HumanPlainView.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Hil Kalathiya — AI Engineer (Agentic AI, RAG, LangGraph). The whole site is one agent run."
    />
  </head>
  <body class="app-shell min-h-screen bg-bg text-text font-sans">
    <HumanViewToggle />
    <div data-view="agent-only">
      <LeftRail />
      <main class="md:ml-56 pb-16">
        <slot />
      </main>
      <TelemetryStrip />
    </div>
    <div data-view="human-only">
      <HumanPlainView />
    </div>
  </body>
</html>
