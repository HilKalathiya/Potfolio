---
import Base from '../layouts/Base.astro';
import BootSequence from '../components/BootSequence';
import HeroTrace from '../components/HeroTrace';
import trace from '../data/hero-trace.json';

const nodeCount = trace.nodes.length;
const chunkCount = trace.corpusSize;
---
<Base title="Hil Kalathiya — AI Engineer">
  <div id="act-0" aria-hidden="true"></div>
  <BootSequence client:load nodeCount={nodeCount} chunkCount={chunkCount} />
  <section id="act-1" class="px-0 py-8 sm:px-6 lg:px-8 lg:py-10 max-w-6xl">
    <HeroTrace client:load trace={trace} />
  </section>
</Base>
