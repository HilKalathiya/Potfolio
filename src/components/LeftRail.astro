---
// SPEC §4 left rail: agent-graph minimap for scroll navigation, current node amber.
// Static node list for Phase 1 — only Act 0 and Act 1 exist; more acts are not
// faked in here until they're actually built.
const sections = [
  { id: 'act-0', label: 'Act 0 · Boot' },
  { id: 'act-1', label: 'Act 1 · First run' },
];
---
<nav
  class="hidden md:flex md:flex-col fixed left-0 top-0 h-screen w-56 border-r border-border bg-surface px-4 py-6 gap-3"
  aria-label="Agent run sections"
>
  <p class="font-mono text-xs text-muted mb-2">agent-graph</p>
  {
    sections.map((s) => (
      <a
        href={`#${s.id}`}
        data-rail-link={s.id}
        class="rail-link font-mono text-xs text-muted hover:text-text px-2 py-1.5 rounded-token border border-transparent"
      >
        <span class="rail-dot" aria-hidden="true"></span> {s.label}
      </a>
    ))
  }
</nav>

<style>
  .rail-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    margin-right: 8px;
  }
  .rail-link.is-active {
    color: var(--text);
    border-color: var(--border);
  }
  .rail-link.is-active .rail-dot {
    background: var(--accent);
  }
</style>

<script>
  // Scroll-spy: lights the current section amber. Pure enhancement — the rail
  // still works as plain anchor links with JS disabled.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]');
  const targets = Array.from(links)
    .map((link) => document.getElementById(link.dataset.railLink!))
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.toggle('is-active', link.dataset.railLink === entry.target.id);
            });
          }
        }
      },
      { rootMargin: '-40% 0px -50% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
